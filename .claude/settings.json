{
  "permissions": {
    "deny": [
      "Read(./private/**)",
      "Edit(./private/**)",
      "Grep(./private/**)",
      "Glob(./private/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-private.py\"",
            "onFailure": "block",
            "statusMessage": "Checking for private/ access"
          }
        ]
      }
    ]
  }
}

# Google Cloud service account with access to the target spreadsheet
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key as-is (including literal \n sequences); lib/sheets.ts unescapes them
GOOGLE_PRIVATE_KEY=
# The ID from the spreadsheet's URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=

# Shared household login password
APP_PASSWORD=
# Random secret used to sign session cookies (e.g. `openssl rand -base64 32`)
JWT_SECRET=
